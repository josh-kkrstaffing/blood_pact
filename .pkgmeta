package-as: BlindTiger

# The old folder name, kept as a tiny helper so saved data carries over the rename.
move-folders:
  BlindTiger/Carryover: BloodPact

ignore:
  - tests
  - tools
  - .github
  - .luacheckrc
  - LAUNCH.md
  - CURSEFORGE.md

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
